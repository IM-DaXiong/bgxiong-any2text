{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bgxiong-any2text",
  "version": "0.1.0",
  "identifier": "com.bgxiong.any2text",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1429",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{"label":"main","title":"比格熊-any2text","decorations":false,"width":1280,"height":850,"minWidth":360,"minHeight":560}],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src asset: http://asset.localhost; img-src 'self' data:",
      "assetProtocol": {"enable":true,"scope":[]}
    }
  },
  "bundle": {"active":true,"targets":["nsis"],"icon":["icons/icon.ico"]}
}
