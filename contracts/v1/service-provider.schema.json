{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IM-DaXiong/bgxiong-any2text/contracts/v1/service-provider.schema.json",
  "title": "Any2Text service provider v1",
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reference": { "type": "string", "minLength": 1, "maxLength": 256 },
    "milliseconds": { "type": "integer", "minimum": 0 },
    "timing": { "enum": ["segmentTimed", "unitTimed"] },
    "sessionRequest": {
      "type": "object", "additionalProperties": false, "required": ["clientKey"],
      "properties": { "clientKey": { "$ref": "#/$defs/digest" } }
    },
    "session": {
      "type": "object", "additionalProperties": false, "required": ["sessionToken", "expiresAt", "endpointInstance"],
      "properties": {
        "sessionToken": { "$ref": "#/$defs/reference" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "endpointInstance": { "$ref": "#/$defs/reference" }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "languages", "timings", "installed", "ready", "inferenceReady", "issues"],
      "properties": {
        "id": { "$ref": "#/$defs/reference" }, "name": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "timings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/timing" } },
        "installed": { "type": "boolean" }, "ready": { "type": "boolean" }, "inferenceReady": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolMin", "protocolMax", "schemaSha256", "providerId", "endpointInstance", "serviceId", "models", "operations", "inputMode", "maxInputBytes", "maxDurationMs", "pause", "resume"],
      "properties": {
        "protocolMin": { "type": "integer", "minimum": 1 }, "protocolMax": { "type": "integer", "minimum": 1 },
        "schemaSha256": { "$ref": "#/$defs/digest" }, "providerId": { "$ref": "#/$defs/reference" },
        "endpointInstance": { "$ref": "#/$defs/reference" }, "serviceId": { "$ref": "#/$defs/reference" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/model" } },
        "operations": { "type": "array", "uniqueItems": true, "items": { "enum": ["transcribe", "organize"] } },
        "inputMode": { "const": "localStream" },
        "maxInputBytes": { "type": "integer", "minimum": 1 }, "maxDurationMs": { "$ref": "#/$defs/milliseconds" },
        "pause": { "type": "boolean" }, "resume": { "type": "boolean" }
      }
    },
    "audioTrack": {
      "type": "object", "additionalProperties": false, "required": ["index", "codec"],
      "properties": { "index": { "type": "integer", "minimum": 0 }, "codec": { "type": "string" } }
    },
    "mediaInput": {
      "type": "object", "additionalProperties": false, "required": ["inputRef", "fingerprint", "durationMs", "audioTracks"],
      "properties": {
        "inputRef": { "$ref": "#/$defs/reference" }, "fingerprint": { "$ref": "#/$defs/digest" },
        "durationMs": { "$ref": "#/$defs/milliseconds" },
        "audioTracks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/audioTrack" } }
      }
    },
    "transcribe": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "inputRef", "inputFingerprint", "modelConfigId", "language", "timing", "audioTrack"],
      "properties": {
        "kind": { "const": "transcribe" }, "inputRef": { "$ref": "#/$defs/reference" },
        "inputFingerprint": { "$ref": "#/$defs/digest" }, "modelConfigId": { "$ref": "#/$defs/reference" },
        "language": { "type": "string", "minLength": 1, "maxLength": 32 },
        "timing": { "$ref": "#/$defs/timing" }, "audioTrack": { "type": "integer", "minimum": 0 }
      }
    },
    "organize": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "inputRef", "inputFingerprint", "draftType", "mode"],
      "properties": {
        "kind": { "const": "organize" }, "inputRef": { "$ref": "#/$defs/reference" },
        "inputFingerprint": { "$ref": "#/$defs/digest" },
        "draftType": { "enum": ["spokenScript", "literaryScript"] }, "mode": { "enum": ["faithful", "creative"] }
      }
    },
    "jobRequest": {
      "type": "object", "additionalProperties": false, "required": ["clientRequestId", "operation"],
      "properties": {
        "clientRequestId": { "type": "string", "format": "uuid" },
        "operation": { "oneOf": [{ "$ref": "#/$defs/transcribe" }, { "$ref": "#/$defs/organize" }] }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "attemptId", "clientRequestId", "status", "committedMs", "durationMs", "result", "error"],
      "properties": {
        "taskId": { "$ref": "#/$defs/reference" }, "attemptId": { "type": "string", "format": "uuid" },
        "clientRequestId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["queued", "running", "pausing", "paused", "cancelling", "cancelled", "failed", "resultReady"] },
        "committedMs": { "$ref": "#/$defs/milliseconds" }, "durationMs": { "$ref": "#/$defs/milliseconds" },
        "result": { "oneOf": [{ "$ref": "#/$defs/result" }, { "type": "null" }] },
        "error": { "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "retainedUntil"],
      "properties": {
        "sha256": { "$ref": "#/$defs/digest" }, "bytes": { "type": "integer", "minimum": 1 },
        "retainedUntil": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false, "required": ["id", "startMs", "endMs", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/reference" }, "startMs": { "$ref": "#/$defs/milliseconds" },
        "endMs": { "$ref": "#/$defs/milliseconds" }, "text": { "type": "string", "minLength": 1 }
      }
    },
    "transcript": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "sourceFingerprint", "durationMs", "timeOrigin", "segments", "timingQuality", "provenance"],
      "properties": {
        "schemaVersion": { "const": 1 }, "sourceFingerprint": { "$ref": "#/$defs/digest" },
        "durationMs": { "$ref": "#/$defs/milliseconds" }, "timeOrigin": { "const": "sourceMedia" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
        "timingQuality": { "$ref": "#/$defs/timing" }, "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
        "waveformPeaks": { "type": "array", "maxItems": 200, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false, "required": ["id", "startMs", "endMs", "text", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/reference" }, "startMs": { "$ref": "#/$defs/milliseconds" },
        "endMs": { "$ref": "#/$defs/milliseconds" }, "text": { "type": "string", "minLength": 1 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["providerId", "modelConfigId"],
      "properties": { "providerId": { "$ref": "#/$defs/reference" }, "modelConfigId": { "$ref": "#/$defs/reference" } }
    },
    "textSnapshot": {
      "type": "object", "additionalProperties": false, "required": ["sourceRevision", "segments"],
      "properties": {
        "sourceRevision": { "$ref": "#/$defs/reference" },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } }
      }
    },
    "draft": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "sourceRevision", "draftType", "mode", "blocks", "abridgedSourceSegmentIds", "complete"],
      "properties": {
        "schemaVersion": { "const": 1 }, "sourceRevision": { "$ref": "#/$defs/reference" },
        "draftType": { "enum": ["spokenScript", "literaryScript"] }, "mode": { "enum": ["faithful", "creative"] },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/draftBlock" } },
        "abridgedSourceSegmentIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
        "complete": { "type": "boolean" }
      }
    },
    "draftBlock": {
      "type": "object", "additionalProperties": false, "required": ["text", "sourceSegmentIds", "addedOrInferred", "abridged"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "sourceSegmentIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
        "addedOrInferred": { "type": "boolean" }, "abridged": { "type": "boolean" }
      }
    }
  }
}
